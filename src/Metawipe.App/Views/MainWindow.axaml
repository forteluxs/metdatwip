<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Metawipe.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="Metawipe.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="metawipe">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">
        <Border Grid.Row="0"
                CornerRadius="8"
                BorderBrush="#4A5568"
                BorderThickness="2"
                Background="#1F2937"
                Padding="20">
            <StackPanel Spacing="8">
                <TextBlock Text="Drop a file or folder"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="Supported: JPEG, PNG, TIFF, HEIC/HEIF, WebP, DOCX, XLSX, PPTX"
                           Opacity="0.85"
                           TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
            <TextBlock Text="Status" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FCA5A5"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
            <TextBlock Text="Inspected file" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding MetadataGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetadataGroupViewModel">
                        <Expander IsExpanded="True" Margin="0,0,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                    <Border Background="#7F1D1D"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            IsVisible="{Binding HasSensitiveFields}">
                                        <TextBlock Text="{Binding SensitiveCount, StringFormat='Sensitive: {0}'}" />
                                    </Border>
                                </StackPanel>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MetadataFieldViewModel">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#334155" Padding="0,6">
                                            <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           TextWrapping="Wrap" />
                                                <Border Grid.Column="2"
                                                        Background="#B91C1C"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        IsVisible="{Binding IsSensitive}">
                                                    <TextBlock Text="Sensitive" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
