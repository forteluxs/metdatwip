<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Metdatwip.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="Metdatwip.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MetaDatWip v1.1.0 — Privacy &amp; Metadata Editor">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">
        <!-- Drop zone & Browse header -->
        <Border Grid.Row="0"
                CornerRadius="8"
                BorderBrush="#4A5568"
                BorderThickness="2"
                Background="#1F2937"
                Padding="20">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                    <TextBlock Text="Drop a file/folder or click Browse to inspect &amp; edit"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="Supported: JPEG, PNG, TIFF, HEIC/HEIF, WebP, DOCX, XLSX, PPTX"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="📁 Browse File..."
                            Click="OnBrowseFileClick"
                            Background="#374151"
                            Foreground="White"
                            Padding="12,8"
                            CornerRadius="6"
                            FontWeight="SemiBold" />

                    <Button Content="🎲 Randomize Metadata"
                            Command="{Binding PopulateRandomMetadataCommand}"
                            Background="#059669"
                            Foreground="White"
                            Padding="12,8"
                            CornerRadius="6"
                            FontWeight="SemiBold"
                            IsVisible="{Binding HasFileLoaded}" />

                    <Button Content="✏️ Save Edits"
                            Command="{Binding SaveEditsCommand}"
                            Background="#2563EB"
                            Foreground="White"
                            Padding="12,8"
                            CornerRadius="6"
                            FontWeight="SemiBold"
                            IsVisible="{Binding HasFileLoaded}" />

                    <Button Content="🧹 Scrub All Privacy Data"
                            Command="{Binding ScrubCurrentFileCommand}"
                            Background="#DC2626"
                            Foreground="White"
                            Padding="12,8"
                            CornerRadius="6"
                            FontWeight="SemiBold"
                            IsVisible="{Binding HasFileLoaded}" />
                </StackPanel>

                <!-- File Path Manual Entry Bar & Overwrite Checkbox -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding InputFilePath, Mode=TwoWay}"
                             PlaceholderText="Or paste/type file path here (e.g. /home/aaa/photo.jpg)..."
                             Background="#111827"
                             Foreground="White"
                             BorderBrush="#374151"
                             Padding="8,6"
                             CornerRadius="4" />
                    <Button Grid.Column="1"
                            Content="🔍 Open &amp; Inspect"
                            Command="{Binding InspectInputPathCommand}"
                            Background="#4F46E5"
                            Foreground="White"
                            Padding="12,6"
                            CornerRadius="4" />
                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding OverwriteOriginalFile, Mode=TwoWay}"
                              Content="Overwrite original file in-place"
                              Foreground="#9CA3AF"
                              VerticalAlignment="Center" />
                </Grid>

                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                             IsIndeterminate="True"
                             Height="4"
                             Margin="0,8,0,0"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <!-- Status area -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
            <TextBlock Text="Status" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#60A5FA" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FCA5A5"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- Inspected file path -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
            <TextBlock Text="Inspected file" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>

        <!-- Metadata Field List with Editing inputs -->
        <ScrollViewer Grid.Row="3" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding MetadataGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetadataGroupViewModel">
                        <Expander IsExpanded="True" Margin="0,0,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                    <Border Background="#7F1D1D"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            IsVisible="{Binding HasSensitiveFields}">
                                        <TextBlock Text="{Binding SensitiveCount, StringFormat='Sensitive: {0}'}" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MetadataFieldViewModel">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#334155" Padding="0,6">
                                            <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="12">
                                                <!-- Field Name -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />

                                                <!-- Editable Value TextBox -->
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Value, Mode=TwoWay}"
                                                         Background="#1E293B"
                                                         Foreground="White"
                                                         BorderBrush="#475569"
                                                         Padding="6,4"
                                                         CornerRadius="4"
                                                         VerticalAlignment="Center" />

                                                <!-- Sensitive Tag Badge -->
                                                <Border Grid.Column="2"
                                                        Background="#B91C1C"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSensitive}">
                                                    <TextBlock Text="Sensitive" Foreground="White" FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
