<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Metdatwip.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="780"
        x:Class="Metdatwip.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MetaDatWip v1.1.0 — Privacy &amp; Metadata Sanitizer Engine"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20">

        <!-- Header Bar -->
        <Border Grid.Row="0"
                Background="#131B2E"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#2563EB"
                            CornerRadius="8"
                            Padding="10,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="18" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="MetaDatWip"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC" />
                            <Border Background="#1E293B"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="v1.1.0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#38BDF8" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Enterprise Privacy &amp; Metadata Sanitizer Engine"
                                   FontSize="12"
                                   Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="📁 Browse File..."
                            Click="OnBrowseFileClick"
                            Background="#1E293B"
                            Foreground="#F8FAFC"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Padding="14,9"
                            CornerRadius="8"
                            FontSize="13"
                            FontWeight="SemiBold" />

                    <Button Content="🎲 Randomize Metadata"
                            Command="{Binding PopulateRandomMetadataCommand}"
                            Background="#059669"
                            Foreground="White"
                            Padding="14,9"
                            CornerRadius="8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding HasFileLoaded}" />

                    <Button Content="✏️ Save Edits"
                            Command="{Binding SaveEditsCommand}"
                            Background="#2563EB"
                            Foreground="White"
                            Padding="14,9"
                            CornerRadius="8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding HasFileLoaded}" />

                    <Button Content="🧹 Scrub All Privacy Data"
                            Command="{Binding ScrubCurrentFileCommand}"
                            Background="#DC2626"
                            Foreground="White"
                            Padding="14,9"
                            CornerRadius="8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding HasFileLoaded}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Drop Zone & File Control Panel -->
        <Border Grid.Row="1"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Drag &amp; Drop File or Folder Here"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <TextBlock Text="Supported Formats: JPEG, PNG, TIFF, HEIC, WebP | DOCX, XLSX, PPTX | MP3, WAV | MP4, MOV, MKV, WebM"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Input Path Bar & Overwrite Checkbox -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             Text="{Binding InputFilePath, Mode=TwoWay}"
                             PlaceholderText="Paste file or directory path here (e.g. /home/user/media/photo.jpg)..."
                             Background="#0F172A"
                             Foreground="#F8FAFC"
                             BorderBrush="#334155"
                             BorderThickness="1"
                             Padding="12,10"
                             CornerRadius="8"
                             FontSize="13" />

                    <Button Grid.Column="1"
                            Content="🔍 Inspect &amp; Load"
                            Command="{Binding InspectInputPathCommand}"
                            Background="#4F46E5"
                            Foreground="White"
                            Padding="16,10"
                            CornerRadius="8"
                            FontSize="13"
                            FontWeight="SemiBold" />

                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding OverwriteOriginalFile, Mode=TwoWay}"
                              Content="⚡ Overwrite Original File (In-Place)"
                              Foreground="#CBD5E1"
                              FontSize="13"
                              VerticalAlignment="Center" />
                </Grid>

                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             CornerRadius="2"
                             Foreground="#38BDF8"
                             IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </Border>

        <!-- Status & Active File Banner -->
        <Border Grid.Row="2"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📄 Source Path:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="{Binding SourcePath}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="#E2E8F0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="13"
                               Foreground="#EF4444"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Metadata Groups List (Expander Cards) -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding MetadataGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetadataGroupViewModel">
                        <Border Background="#111827"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="10"
                                Margin="0,0,0,14"
                                Padding="12">
                            <Expander IsExpanded="True" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Header}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#F8FAFC" />
                                            <Border Background="#7F1D1D"
                                                    BorderBrush="#991B1B"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10,3"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding HasSensitiveFields}">
                                                <TextBlock Text="{Binding SensitiveCount, StringFormat='⚠️ Sensitive: {0}'}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FCA5A5" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>

                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MetadataFieldViewModel">
                                            <Border BorderThickness="0,0,0,1"
                                                    BorderBrush="#1E293B"
                                                    Padding="6,8">
                                                <Grid ColumnDefinitions="240,*,Auto" ColumnSpacing="14">
                                                    <!-- Field Label -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#CBD5E1"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />

                                                    <!-- Editable Input Box -->
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Value, Mode=TwoWay}"
                                                             Background="#0F172A"
                                                             Foreground="#F8FAFC"
                                                             BorderBrush="#334155"
                                                             BorderThickness="1"
                                                             Padding="10,6"
                                                             CornerRadius="6"
                                                             FontSize="13"
                                                             VerticalAlignment="Center" />

                                                    <!-- Sensitive Badge -->
                                                    <Border Grid.Column="2"
                                                            Background="#7F1D1D"
                                                            BorderBrush="#991B1B"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding IsSensitive}">
                                                        <TextBlock Text="Sensitive"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FCA5A5" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
